    CONSTRAINT FK_BookingDocuments_Booking FOREIGN KEY (BookingID) REFERENCES FlightBooking(BookingID),
    CONSTRAINT CHK_DocumentType CHECK (DocumentType IN ('TICKET', 'REFUND'))
);


